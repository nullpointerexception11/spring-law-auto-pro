{
  "info": {
    "name": "Spring Law Auto API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "orgId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "caseId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "clientId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "userId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Auth Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"orgId\": \"{{orgId}}\",\n  \"email\": \"admin@example.com\",\n  \"fullName\": \"Admin User\",\n  \"password\": \"secret123\",\n  \"role\": \"ADMIN\"\n}" },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"orgId\": \"{{orgId}}\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"secret123\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "List Hearings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/operations/hearings?orgId={{orgId}}"
      }
    },
    {
      "name": "Create Hearing",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"orgId\": \"{{orgId}}\",\n  \"caseId\": \"{{caseId}}\",\n  \"hearingAt\": \"2026-05-08T10:00:00\",\n  \"court\": \"Istanbul 1. Asliye\",\n  \"notes\": \"ilk durusma\",\n  \"result\": null,\n  \"createdByUserId\": \"{{userId}}\"\n}" },
        "url": "{{baseUrl}}/api/operations/hearings"
      }
    },
    {
      "name": "List Deadlines",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/operations/deadlines?orgId={{orgId}}"
      }
    },
    {
      "name": "Create Deadline",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"orgId\": \"{{orgId}}\",\n  \"caseId\": \"{{caseId}}\",\n  \"type\": \"APPEAL\",\n  \"dueAt\": \"2026-05-20T17:00:00\",\n  \"remindAt\": \"2026-05-18T09:00:00\",\n  \"status\": \"OPEN\",\n  \"notes\": \"evrak hazirla\",\n  \"createdByUserId\": \"{{userId}}\"\n}" },
        "url": "{{baseUrl}}/api/operations/deadlines"
      }
    },
    {
      "name": "List Case Payments",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/operations/case-payments?orgId={{orgId}}"
      }
    },
    {
      "name": "Create Case Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"orgId\": \"{{orgId}}\",\n  \"caseId\": \"{{caseId}}\",\n  \"amount\": 12500.00,\n  \"currency\": \"TRY\",\n  \"paidAt\": \"2026-05-07T14:30:00\",\n  \"method\": \"BANK_TRANSFER\",\n  \"note\": \"ilk odeme\",\n  \"receiptFileId\": null,\n  \"recordedByUserId\": \"{{userId}}\"\n}" },
        "url": "{{baseUrl}}/api/operations/case-payments"
      }
    }
  ]
}
